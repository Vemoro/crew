{
  "files": {
    "includes": [
      "**/*.js", "**/*.mjs", "**/*.cjs", "**/*.jsx", "**/*.ts", "**/*.mts", "**/*.cts", "**/*.tsx",
      "!test/**", "!tests/**", "!**/*.test.*", "!**/*.spec.*", "!scripts/check-browser.ts",
      "!.output/**", "!.tanstack/**", "!src/routeTree.gen.ts", "!public/dialogs.js", "!public/pwa.js", "!public/service-worker.js"
    ]
  },
  "formatter": { "enabled": false },
  "linter": {
    "rules": {
      "preset": "none",
      "complexity": {
        "noExcessiveLinesPerFunction": { "level": "info", "options": { "maxLines": 80, "skipBlankLines": true } }
      }
    }
  }
}
